# Environment Variables Example for Ricake

# Google Apps Script Web App Deployment URL (Step 2)
APPS_SCRIPT_URL=https://script.google.com/macros/s/AKfycby.../exec

# Shared Secret Token between Next.js server & Apps Script (Step 2)
APPS_SCRIPT_SECRET=your_long_random_secret_here

# JWT Auth Secret for Session Cookies (Step 2)
AUTH_SECRET=your_jwt_auth_secret_here

# Next.js Public App URL
NEXT_PUBLIC_APP_URL=http://localhost:3000
